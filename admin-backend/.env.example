# UPITS 2026 Admin Backend — environment variables
# Copy this file to .env for local dev. On Vercel, set the same two keys
# under Project Settings → Environment Variables.

# MUST be the exact same database as your student backend — same Neon
# project, same database name. For serverless (Vercel), prefer Neon's
# *pooled* connection string (hostname contains "-pooler") so many
# short-lived function invocations don't exhaust Neon's connection limit.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx-pooler.ap-southeast-1.aws.neon.tech/upits_passport?sslmode=require

# MUST be the EXACT SAME value as CERT_TOKEN_SECRET in your student
# backend's .env. The student backend signs each completion QR with
# this secret when a passport finishes; this admin backend verifies
# that same signature at the Redemption Desk and Certificates screen.
# If the two services use different values, every redemption lookup
# will fail with "Invalid completion code."
CERT_TOKEN_SECRET=change-me-to-the-same-long-random-string-as-student-backend

# --- Admin login (single shared login — see utils/admin_auth.py) ---
# Pick your own username/password before deploying. These are NOT
# related to CERT_TOKEN_SECRET or the student backend at all.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-strong-password

# Used only to sign the admin session token issued after login. Any
# long random string — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
